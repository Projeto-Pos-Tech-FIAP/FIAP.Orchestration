# Copie para ".env" (fora do git) e troque todo CHANGE_ME por um valor seu. O mesmo
# arquivo alimenta o docker compose e o scripts/create-k8s-secrets.sh.
#
# MSSQL_SA_PASSWORD precisa ter 8+ caracteres com maiusculas, minusculas e digitos,
# e nao pode conter ";" (vai dentro da connection string).

MSSQL_SA_PASSWORD=CHANGE_ME
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME
KEYCLOAK_POSTGRES_USER=keycloak
KEYCLOAK_POSTGRES_PASSWORD=CHANGE_ME
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KEYCLOAK_CLIENT_SECRET=CHANGE_ME
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Busca avancada (Elasticsearch). Deixe em branco para o cluster local, que sobe sem
# security e portanto sem credencial. Preencha apenas se apontar Elasticsearch__Uri
# para um endpoint gerenciado (Elastic Cloud / Amazon OpenSearch).
ELASTICSEARCH_API_KEY=

# Se voce nao vai mexer na Lambda/tunel, deixe os valores abaixo como estao: o Kafka
# sobe normal com o certificado de exemplo versionado no repo do FIAP.NotificationsAPI.
#
# Pra usar a Lambda de verdade, veja FIAP.NotificationsAPI/README.md, secao
# "Migracao serverless (AWS Lambda + Kafka trigger)", e depois preencha estes
# 4 valores com os MESMOS que voce colocou no .env do FIAP.NotificationsAPI.

KAFKA_CERTS_DIR=../FIAP.NotificationsAPI/kafka-certs-default
TUNNEL_ADVERTISED_ADDRESS=localhost:9094
KAFKA_TUNNEL_SASL_PASSWORD=kafka-tunnel-default-pass
KAFKA_TUNNEL_KEYSTORE_PASSWORD=kafka-tunnel-default-pass
